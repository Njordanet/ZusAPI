# ZüsAPI Configuration
APP_NAME=ZüsAPI
APP_ENV=production
API_PORT=8000
LOG_LEVEL=info
DATA_DIR=/app/data

# PostgreSQL + PostGIS Database (on NVMe SSD)
POSTGRES_USER=zus
POSTGRES_PASSWORD=zus_olympus_pass
POSTGRES_DB=zus_telemetry
DATABASE_URL=postgresql://zus:zus_olympus_pass@zus-db:5432/zus_telemetry

# Optional Nowcast API Keys (Zero-key HRRR 15-min nowcasting is active by default)
PIRATE_WEATHER_API_KEY=
TOMORROW_IO_API_KEY=
